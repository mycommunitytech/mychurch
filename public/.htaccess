# Своя сторінка 404 замість дефолтної від Apache.
# Next.js кладе експортовану сторінку not-found у корінь як /404.html,
# а цей файл потрапляє в корінь сайту разом із рештою public/.
ErrorDocument 404 /404.html

# Картинки для соцмереж Next кладе файлами без розширення
# (/opengraph-image, /blog/<стаття>/opengraph-image). Apache віддав би
# їх як text/plain, і превʼю в месенджерах не було б.
#
# Тепер `og:image` веде на копію з розширенням, яку робить
# scripts/og-png.mjs, — її хостинг віддає як image/png сам. Це правило
# лишається заради старих посилань, що вже осіли в кешах соцмереж.
<FilesMatch "^opengraph-image$">
  ForceType image/png
</FilesMatch>

# --- Редиректи ---
#
# Хостинг тримає Apache за nginx, і сам Apache бачить запит як звичайний http.
# Через це будь-який його власний редирект — і дописування косої риски
# (DirectorySlash), і Redirect із відносною ціллю — віддає в Location
# http://, а не https://. Браузер із примусовим HTTPS такий перехід ріже,
# і людина замість сторінки бачить помилку завантаження.
#
# Тому всі редиректи пишемо самі, абсолютними й зі схемою https.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Один хост на весь сайт. www.mychurch.com.ua віддавав ту саму сторінку
  # кодом 200, тобто кожна адреса існувала двічі: пошук бачить дубль, а вага
  # посилань ділиться між двома копіями. Canonical у <head> лише підказка —
  # редирект прибирає дубль насправді. Правило стоїть першим, щоб решта
  # (коса риска, амбасадори) відпрацьовувала вже на канонічному хості.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Список амбасадорів окремою сторінкою не потрібен — він один.
  # Раніше це робив redirects() у next.config, але статичний експорт
  # редиректів не вміє, тож правило живе на хостингу.
  RewriteRule ^ambassadors/?$ https://%{HTTP_HOST}/ambassadors/newlife/ [R=301,L]

  # Сторінка амбасадора переїхала з /nove-zhyttia на /newlife — так само,
  # як зветься сайт церкви. Старе посилання вже розійшлось, тож ведемо його
  # на нову адресу, а не в 404.
  RewriteRule ^ambassadors/nove-zhyttia/?$ https://%{HTTP_HOST}/ambassadors/newlife/ [R=301,L]

  # Дві статті про CRM прибрано з блогу 2026-10-07 («Церковна СРМ: що це і
  # як її обрати», «Яку CRM обрати для церкви: порівняння систем»). Їх уже
  # проіндексовано, тож людина з пошуку потрапляє в блог, а не в 404.
  RewriteRule ^blog/(tserkovna-crm|porivniannia-crm-dlia-tserkvy)/?$ https://%{HTTP_HOST}/blog/ [R=301,L]

  # Коса риска в кінці. Експорт кладе кожну сторінку текою з index.html,
  # тож /modules без риски — це запит теки, який інакше дописав би mod_dir.
  # У .htaccess mod_rewrite відпрацьовує раніше за нього, тож слово лишається
  # за цим правилом.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ https://%{HTTP_HOST}/$1/ [R=301,L]
</IfModule>

# Якщо mod_rewrite на хостингу вимкнуть — хоч /ambassadors лишиться живим.
# Саме RedirectMatch із ^...$: звичайний Redirect збігається за префіксом,
# і під нього потрапила б сама /ambassadors/newlife/, отримавши
# нескінченний редирект на себе.
<IfModule !mod_rewrite.c>
  RedirectMatch 301 ^/ambassadors/?$ https://mychurch.com.ua/ambassadors/newlife/
  RedirectMatch 301 ^/ambassadors/nove-zhyttia/?$ https://mychurch.com.ua/ambassadors/newlife/
  RedirectMatch 301 ^/blog/(tserkovna-crm|porivniannia-crm-dlia-tserkvy)/?$ https://mychurch.com.ua/blog/
</IfModule>

# --- Текстові файли ---
#
# robots.txt і llms.txt хостинг віддає як text/plain без charset, і частина
# клієнтів читає кирилицю в llms.txt як latin-1. Явне UTF-8 це прибирає.
<IfModule mod_mime.c>
  AddCharset UTF-8 .txt
</IfModule>

# --- Демо-записи ---
#
# Файли в /clips/ важать по 8–12 МБ і ніколи не міняються без нової
# назви, тож нехай браузер тримає їх місяць і не тягне вдруге.
# Без `immutable`: якщо перезаллємо той самий файл, кеш підхопить
# оновлення на наступному заході, а не через рік.
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# --- Кеш сторінок ---
#
# Статику (js, css, картинки, шрифти, .txt) хостинг віддає nginx-ом сам,
# з кешем на 30 днів (у відповідях його ETag і Expires) — до Apache і цього
# файла вона не доходить. Через Apache проходять лише HTML-сторінки, і саме
# їм потрібне «щоразу перевіряти»: назви шматків js/css у кожній збірці
# нові, тож стара сторінка з кешу браузера після заливки посилалась би на
# файли, яких уже немає. З no-cache браузер питає сервер (304, якщо не
# змінилось) і одразу бачить нову збірку. Те саме для Google: свіжа
# сторінка на кожному обході. Кеш на пристрої для роботи без мережі — це
# вже сервіс-воркер (sw.js у корені, scripts/sw.template.js).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
