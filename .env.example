# Сайт збирається в статику (output: "export" у next.config.ts), тож
# серверних змінних тут немає: усе, що нижче, потрапляє в браузер.

# ── Заявки ───────────────────────────────────────────────────────────────────
# Заявки з модалки демо і з брифу на /modules їдуть прямо в CRM «Моя Церква»:
# публічна форма приймає їх без жодного секрета в статиці (одноразовий токен
# видає сама CRM). У CRM вони лягають на дошку «Заявка з сайту mychurch.com.ua»
# → Форми → заявки, звідти працюють відповідальні й Telegram-сповіщення.
#
# Порожні значення = беруться типові, вказані нижче.
NEXT_PUBLIC_CRM_URL=https://api.mychurch.pp.ua
NEXT_PUBLIC_CRM_FORM_SLUG=mychurch-site

# Запасний приймач: public/lead.php (він тримає токен бота й пише в Telegram).
# Спрацьовує, лише якщо CRM не відповіла, — щоб заявка не загубилась.
# Порожньо — запасного шляху немає, форма покаже телефон і пошту.
NEXT_PUBLIC_LEAD_ENDPOINT=/lead.php

# Публічне посилання на Telegram для кнопок «Написати в Telegram».
# Порожнє — кнопки ведуть на https://t.me/mychurch_team (SITE_TELEGRAM_HANDLE у src/lib/seo.ts).
NEXT_PUBLIC_TELEGRAM_URL=

# Домен для canonical/OG у прев'ю та стейджингу
NEXT_PUBLIC_SITE_URL=

# ── Аналітика: Firebase Analytics (GA4) ──────────────────────────────────────
# Єдиний лічильник сайту. Конфіг беруть у консолі Firebase →
# Project settings → Your apps. Порожні значення = статистика не збирається.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Токен підтвердження прав у Google Search Console (тег google-site-verification).
# Порожньо — тег не додається.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Календар зустрічей (Calendly) ────────────────────────────────────────────
# Сторінка або тип події, наприклад https://calendly.com/mychurch/demo.
# З адресою на сайті з'являються входи «Обрати час зустрічі»: тихий лінк у
# фінальному блоці (замість Telegram), кнопка після заявки в модалці демо
# і рядок у контактах футера; календар відкривається у власному вікні
# (src/components/shared/calendly-modal.tsx). Порожньо — входів немає.
NEXT_PUBLIC_CALENDLY_URL=
